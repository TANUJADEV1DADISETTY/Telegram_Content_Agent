# Telegram Bot Setup
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets Configuration
# Note: GOOGLE_SHEETS_CREDENTIALS_JSON can be either the raw JSON string from your service account key file
# OR a path to the service account JSON file inside the container (e.g. if you bind mount it).
GOOGLE_SHEETS_CREDENTIALS_JSON={"type": "service_account", ...}
GOOGLE_SHEET_NAME=Telegram Content Agent
GOOGLE_SHEET_ID=your_google_sheet_id_here (optional)

# LLM Backend Provider Setup
# Supported values: gemini, groq, ollama
LLM_PROVIDER=gemini

# LLM Providers Configuration (fill the one you choose)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ollama settings (applicable if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
